{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "WHATSAPP_TOKEN": "@whatsapp_token",
    "PHONE_NUMBER_ID": "@phone_number_id",
    "SHEET_NAME": "@sheet_name",
    "SPREADSHEET_ID": "@spreadsheet_id"
  }
}
