MONGODB_URI=your_mongodb_uri
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_whatsapp_phone_id
WHATSAPP_WEBHOOK_VERIFY=your_webhook_verify_token
SPREADSHEET_ID=your_spreadsheet_id
SHEET_NAME=Sheet1

# Environment
NODE_ENV=development

# Security Configuration
# CORS - Comma-separated list of allowed origins (leave empty in development to allow all)
ALLOWED_ORIGINS=https://your-frontend.com,https://your-admin.com,https://your-mobile-app.com

# Trust Proxy - Set to 'true' when behind reverse proxy (Vercel, Heroku, AWS ELB, Nginx, etc.)
TRUST_PROXY=false

# Rate Limiting Configuration (optional - default values are used if not defined)
# General API Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limit (previene ataques de fuerza bruta)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Appointment Creation Rate Limit
RATE_LIMIT_APPOINTMENT_WINDOW_MS=3600000
RATE_LIMIT_APPOINTMENT_MAX=10

# Webhook Rate Limit
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=30

# Write Operations Rate Limit
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=20

# Read Operations Rate Limit
RATE_LIMIT_READ_WINDOW_MS=300000
RATE_LIMIT_READ_MAX=50
