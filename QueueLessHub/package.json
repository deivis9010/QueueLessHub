{
  "name": "queuelesshub",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"ts-node src/server.ts\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "vercel-build": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll --verbose",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=text-summary",
    "test:integration": "jest src/tests/integration",
    "test:integration:coverage": "jest src/tests/integration --coverage --silent",
    "test:unit": "jest src/tests --testPathIgnorePatterns=/integration/ --testPathIgnorePatterns=/e2e/",
    "test:unit:coverage": "jest src/tests --testPathIgnorePatterns=/integration/ --testPathIgnorePatterns=/e2e/ --coverage --silent",
    "test:e2e": "jest src/tests/e2e",
    "test:url-validation": "ts-node scripts/test-url-validation.ts",
    "test:rate-limit": "ts-node scripts/test-rate-limit.ts",
    "cleanup:duplicate-appointments": "ts-node scripts/remove-duplicate-appointments.ts",
    "swagger:generate": "ts-node scripts/generate-swagger.ts",
    "lint": "eslint src --ext .ts",
    "lint:strict": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "ci": "npm run check && npm run format:check && npm run lint:strict && npm run test"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/tests/**",
      "!src/server.ts",
      "!src/swagger.ts",
      "!src/swagger-components.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    },
    "testMatch": [
      "**/src/tests/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true,
    "maxWorkers": "50%"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^153.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
